<link rel="stylesheet" href="/css/home.css">

<section class="home">
    <% if (!user) { %>
        <!-- 로그인 안 한 상태 -->
<div id="np-container" class="now-playing-section">
    <div id="np" class="np-inner">
        
        <!-- 왼쪽: 앨범 -->
        <div class="np-left">
            <div class="album-art big" id="np-cover">
                <img id="np-cover-img" src="/img/album-placeholder.png" alt="Album cover">
            </div>

            <div class="np-track-info">
                <div id="np-track-name" class="np-track-name">로그인 후 이용해 주세요!</div>
                <div id="np-artist" class="np-artist muted"></div>
            </div>
        </div>

        <!-- 오른쪽 설명 (항상 고정) -->
        <div class="np-right">
            <h1 class="np-heading">
                <span class="now">NOW -</br></span>
                <span class="playing">PLAYING</span>
            </h1>

            <p class="np-body">
                now-playing은 사람들이 지금 어떤 음악을 듣고 있는지 쉽게 공유하고
                확인할 수 있는 서비스입니다. 사용자는 자신의 재생 음악을 자연스럽게 보여줄 
                수 있고, 친구들이 어떤 곡을 듣는지 실시간 흐름처럼 살펴볼 수 있습니다. 
            </p>

            <p class="np-body">
                취향이 드러나는 순간을 서로 가볍게 공유하며, 새로운 음악을 발견해 보세요!
            </p>
        </div>
    </div>
</div>
    <% } else if (!user.spotifyAccessToken) { %>
        <!-- 로그인 했지만 Spotify 미연동 -->
        <div class="placeholder">
            <h2>@<%= user.username %> 님, Spotify 연동이 필요해요 🎶</h2>
            <p class="muted">연동하면 현재 재생 중인 곡과 취향 분석을 볼 수 있어요.</p>
            <a class="btn btn-spotify" href="/api/spotify/login">Spotify 연동하러 가기</a>
        </div>

    <% } else { %>
        <!-- 로그인 + Spotify 연동된 상태 -->

        <!-- 1. Now Playing 영역 -->
<div id="np-container" class="now-playing-section">
    <div id="np" class="np-inner">
        
        <!-- 왼쪽: 앨범 -->
        <div class="np-left">
            <div class="album-art big" id="np-cover">
                <img id="np-cover-img" src="/img/album-placeholder.png" alt="Album cover">
            </div>

            <div class="np-track-info">
                <div id="np-track-name" class="np-track-name">음악을 재생해 보세요!</div>
                <div id="np-artist" class="np-artist muted"></div>
            </div>
        </div>

        <!-- 오른쪽 설명 (항상 고정) -->
        <div class="np-right">
            <h1 class="np-heading">
                <span class="now">NOW -</br></span>
                <span class="playing">PLAYING</span>
            </h1>

            <p class="np-body">
                now-playing은 사람들이 지금 어떤 음악을 듣고 있는지 쉽게 공유하고
                확인할 수 있는 서비스입니다. 사용자는 자신의 재생 음악을 자연스럽게 보여줄 
                수 있고, 친구들이 어떤 곡을 듣는지 실시간 흐름처럼 살펴볼 수 있습니다. 
            </p>

            <p class="np-body">
                취향이 드러나는 순간을 서로 가볍게 공유하며, 새로운 음악을 발견해 보세요!
            </p>
        </div>
    </div>
</div>


<section class="global-section">
    <div class="global-inner">
        <h2 class="global-title">GLOBAL TOP - 10</h2>
        <div id="global-chart-container" class="global-chart"></div>
    </div>
</section>
            <!-- 내 Top 트랙 10곡 -->
            <section class="mytop-section">
    <h2 class="global-title">MY TOP - 10</h2>

    <!-- 여기 안을 home.js에서 채움 -->
    <div id="top-tracks-container" class="global-chart"></div>
</section>


            <!-- 내 Top 아티스트 3명 -->
            <section class="artist-section">
    <h2 class="artist-title">ARTIST</h2>

    <!-- JS에서 여기를 동그라미 3개로 채움 -->
    <div id="top-artists-container" class="artist-grid">
        <p>로딩 중...</p>
    </div>
</section>

<script src="/js/home.js"></script>

    <% } %>
</section>

