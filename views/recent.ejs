<link rel="stylesheet" href="/css/recent.css">

<section class="recent">
  <% if (!user) { %>
    <div class="recent-placeholder">
      <p>최근 재생 내역을 보려면 로그인하세요.</p>
      <a class="btn" href="/login">로그인하기</a>
    </div>
  <% } else { %>
    <div class="recent-header">
      <div class="recent-tabs">
        <button id="tabMe" class="recent-tab active">ME</button>
        <button id="tabFriends" class="recent-tab">FRIENDS</button>
      </div>

      <div class="recent-meta">
        <span id="status" class="recent-status muted"></span>
        <span id="count" class="recent-count muted"></span>
      </div>
    </div>

    <!-- 가로 갤러리 영역 -->
    <ul id="list" class="recent-gallery">
      <!-- recent.js에서 카드 li들 주입 -->
    </ul>
  <% } %>
</section>

<script src="/js/recent.js"></script>
