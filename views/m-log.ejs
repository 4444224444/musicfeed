<link rel="stylesheet" href="/css/m-log.css">

<main class="mlog-page">
  <div class="mlog-container">
    <aside class="mlog-sidebar">
      <header class="mlog-sidehead">
        <h1 class="mlog-brand">MLOG</h1>
      </header>

      <section
        class="mlog-profile"
        id="mlog-my-profile"
        data-user-id="<%= me._id %>"
      >
        <h2 class="mlog-username"><%= me.username %></h2>
        <p class="mlog-profile-sub">나의 음악 기록</p>
      </section>

      <section class="mlog-friends">
        <div class="mlog-friends-header">
          <h3>친구 목록</h3>
          <a href="/friends" class="mlog-friends-manage">관리</a>
        </div>

        <% if (friends && friends.length > 0) { %>
          <ul class="mlog-friends-list">
            <% friends.forEach(function(friend) { %>
              <li class="mlog-friend-item" data-user-id="<%= friend._id %>">
                <span class="mlog-friend-name"><%= friend.username %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mlog-friends-empty">추가된 친구가 없다.</p>
        <% } %>
      </section>
    </aside>

    <section class="mlog-feed-area">
      <header class="mlog-feed-header">
        <h2>FEED</h2>
      </header>

      <div id="mlog-feed">
        <p class="mlog-feed-loading">불러오는 중...</p>
      </div>
    </section>
  </div>
</main>

<script src="/js/m-log.js"></script>

