<link rel="stylesheet" href="/css/mylogdetail.css">

<main
  id="mylogDetailPage"
  class="mylog-detail-page"
  data-post-id="<%= postId %>"
  data-my-user-id="<%= myUserId %>"
>
  <div class="mylog-detail-wrap">
    <header id="postHeader" class="post-header"></header>

    <section id="postBody" class="post-body"></section>

    <section id="postActions" class="post-actions">
      <button type="button" id="openCommentsBtn" class="btn-primary">댓글 보기</button>
      <span id="actionMsg" class="muted"></span>
    </section>
  </div>

  <!-- 댓글 바텀시트 -->
  <div id="commentOverlay" class="comment-overlay"></div>

  <section id="commentSheet" class="comment-sheet" aria-hidden="true">
    <div class="comment-sheet-inner">
      <div class="comment-sheet-head">
        <h2 class="comment-sheet-title">댓글</h2>
        <button type="button" id="closeCommentsBtn" class="sheet-close">닫기</button>
      </div>

      <ul id="commentList" class="comment-list"></ul>

      <form id="commentForm" class="comment-form">
        <textarea
          id="commentInput"
          rows="2"
          placeholder="댓글을 입력해 달라."
        ></textarea>
        <button type="submit" class="btn-primary">등록</button>
      </form>

      <p id="commentMsg" class="muted"></p>
    </div>
  </section>
</main>

<script src="/js/mylog-detail.js"></script>

