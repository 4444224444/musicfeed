<link rel="stylesheet" href="/css/playlists.css">

<section class="playlists-page">
  <!-- 상단 헤더 -->
  <header class="pl-header">
    <div class="pl-title-row">
      <h2 class="pl-main-title">MY PLAYLISTS</h2>
      <button id="open-create-modal" class="pl-add-btn" type="button">+</button>
    </div>
    <p class="pl-subtitle">
      버튼을 눌러 랜덤으로 플레이리스트를 만들어 보세요!
    </p>
  </header>

  <!-- 그리드 영역 -->
  <section class="pl-grid-section">
    <div id="playlist-list" class="pl-grid">
      <p class="muted">로딩 중...</p>
    </div>
  </section>
</section>

<!-- 공통 오버레이 -->
<div id="pl-sheet-overlay" class="pl-overlay"></div>

<!-- 🔻 플레이리스트 생성 바텀시트 -->
<div id="pl-create-sheet" class="pl-sheet">
  <div class="pl-sheet-inner">
    <!-- 왼쪽: 이미지 박스 -->
    <div class="pl-image-area">
      <div id="pl-image-box" class="pl-image-box">
        <span class="pl-image-plus">+</span>
        <span class="pl-image-text">커버 이미지 추가</span>
        <input type="file" accept="image/*" hidden />
      </div>
    </div>

    <!-- 오른쪽: 입력 폼 -->
    <div class="pl-form-area">
      <form id="playlist-modal-form">
        <div class="pl-field">
          <label for="pl-name-modal">플레이리스트 이름</label>
          <input
            id="pl-name-modal"
            type="text"
            placeholder="예) night driving mix"
            required
          />
        </div>

        <div class="pl-field">
          <label for="pl-genre-modal">장르</label>
          <select id="pl-genre-modal" required>
            <option value="">장르를 선택해 주세요</option>
            <option value="k-pop">K-pop</option>
            <option value="pop">Pop</option>
            <option value="rnb">R&B</option>
            <option value="hip-hop">Hip-hop</option>
            <option value="jazz">Jazz</option>
            <option value="edm">EDM</option>
            <option value="rock">Rock</option>
            <option value="ballad">Ballad</option>
            <option value="indie">Indie</option>
            <option value="lofi">Lofi</option>
          </select>
        </div>

        <div class="pl-sheet-actions">
          <button type="button" id="pl-cancel-btn" class="btn-secondary">
            취소
          </button>
          <button type="submit" class="btn-primary">
            생성하기
          </button>
        </div>

        <p id="pl-message" class="pl-msg"></p>
      </form>
    </div>
  </div>
</div>

<!-- 🔻 플레이리스트 상세 모달 (화면 정중앙) -->
<div id="pl-detail-modal" class="pl-detail">
  <div class="pl-detail-inner">
    <button id="pl-detail-close" class="pl-detail-close" type="button">
      &times;
    </button>

    <!-- 🔵 커버 이미지 추가 부분 -->
    <div class="pl-detail-cover-wrap">
      <div class="pl-detail-cover">
        <img id="pl-detail-cover" src="" alt="playlist cover" />
      </div>
    </div>

    <h3 id="pl-detail-title" class="pl-detail-title"></h3>
    <p id="pl-detail-meta" class="pl-detail-meta"></p>
    <ul id="pl-detail-tracks" class="pl-detail-tracks"></ul>
  </div>
</div>

<script src="/js/playlists.js"></script>
