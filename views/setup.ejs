<link rel="stylesheet" href="/css/setup.css">

<section class="settings-page">
  <h2>SET UP</h2>
  <p class="muted-info">계정 정보 및 연동 설정</p>

  <div class="section-card">
    <h3>기본 정보</h3>
    <p class="setting-detail">
      계정 생성일 · <%= user.createdAt.toLocaleDateString('ko-KR') %>
    </p>

    <form id="update-username-form" class="setting-form">
      <div class="form-group">
        <label for="username">이름</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= user.username %>"
          required
        >
      </div>
      <button type="submit" class="btn btn-primary btn-small">수정</button>
      <p id="username-status" class="status-message"></p>
    </form>

    <form id="update-password-form" class="setting-form">
      <div class="form-group">
        <label for="current-password">현재 비밀번호</label>
        <input
          type="password"
          id="current-password"
          name="currentPassword"
          required
        >
      </div>

      <div class="form-group">
        <label for="new-password">새 비밀번호</label>
        <input
          type="password"
          id="new-password"
          name="newPassword"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary btn-small">
        비밀번호 변경
      </button>
      <p id="password-status" class="status-message"></p>
    </form>
  </div>

  <div class="section-card">
    <h3>Spotify</h3>

    <% if (user.spotifyAccessToken) { %>
      <p class="status-connected">연결됨</p>
      <button id="disconnect-spotify" class="btn btn-danger btn-small">
        연결 해제
      </button>
      <p id="spotify-status" class="status-message"></p>
    <% } else { %>
      <p class="status-disconnected">연결되지 않음</p>
      <a href="/api/spotify/login" class="btn btn-spotify btn-small">
        Spotify 연결
      </a>
    <% } %>
  </div>

  <div class="section-card danger-zone">
    <h3>계정</h3>

    <div class="setting-item">
      <a href="#" id="logout-link" class="btn btn-primary btn-ghost btn-small">
        로그아웃
      </a>
    </div>

    <div class="setting-item">
      <button id="delete-account-btn" class="btn btn-danger btn-small">
        계정 삭제
      </button>
    </div>
  </div>
</section>

<script src="/js/setup.js"></script>
